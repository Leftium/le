{
  "name": "leftium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.3.4",
  "bin": {
    "leftium": "dist/src/cli/index.js",
    "le": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "rescript && tsc",
    "typecheck": "rescript && tsc --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "dev:rescript": "rescript watch",
    "dev:typescript": "tsc --watch",
    "start": "node dist/src/cli/index.js"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@rescript/runtime": "12.3.1",
    "commander": "15.0.0",
    "jsonc-parser": "3.3.1",
    "minimatch": "10.2.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "rescript": "12.3.1",
    "typescript": "7.0.2"
  }
}
